@implements IAsyncDisposable
@using Sigil.Application.Input
@using Sigil.Server.Client.Services
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ShortcutTargetRegistry Targets

<ShortcutOverlay IsOpen="_showHelp" HasProjectContext="_hasProjectContext" OnClose="CloseHelp" />

@code {
    private readonly KeyboardShortcutParser _parser = new();
    private IJSObjectReference? _module;
    private DotNetObjectReference<ShortcutLayer>? _dotNetRef;
    private bool _showHelp;
    private bool _hasProjectContext;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _hasProjectContext = ProjectPath.ProjectIdFrom(Navigation.Uri).HasValue;
        Navigation.LocationChanged += OnLocationChanged;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/keyboard-shortcuts.js");
        _dotNetRef = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("register", _dotNetRef);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _hasProjectContext = ProjectPath.ProjectIdFrom(e.Location).HasValue;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task HandleShortcutAsync(string key)
    {
        if (string.IsNullOrEmpty(key)) return;

        switch (_parser.Push(key[0]))
        {
            case ShortcutAction.NavigateIssues:
                await NavigateToProjectAsync("issues");
                break;
            case ShortcutAction.NavigateReleases:
                await NavigateToProjectAsync("releases");
                break;
            case ShortcutAction.NavigateEvents:
                await NavigateToProjectAsync("events");
                break;
            case ShortcutAction.NavigateDashboard:
                Navigation.NavigateTo("/");
                break;
            case ShortcutAction.FocusNext:
                await MoveFocusAsync(1);
                break;
            case ShortcutAction.FocusPrevious:
                await MoveFocusAsync(-1);
                break;
            case ShortcutAction.ResolveFocused:
                await ResolveFocusedAsync();
                break;
            case ShortcutAction.ShowHelp:
                _showHelp = !_showHelp;
                break;
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task NavigateToProjectAsync(string section)
    {
        if (ProjectPath.ProjectIdFrom(Navigation.Uri) is not { } projectId) return Task.CompletedTask;

        Navigation.NavigateTo($"/projects/{projectId}/{section}");
        return Task.CompletedTask;
    }

    private async Task MoveFocusAsync(int delta)
    {
        if (Targets.Target is not { } target) return;

        var focusedId = await target.MoveFocusAsync(delta);
        if (focusedId is not null && _module is not null)
            await _module.InvokeVoidAsync("scrollElementIntoView", focusedId);
    }

    private async Task ResolveFocusedAsync()
    {
        if (Targets.Target is not { } target) return;

        await target.ResolveFocusedAsync();
    }

    private void CloseHelp() => _showHelp = false;

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregister");
                await _module.DisposeAsync();
            }
            catch (JSException)
            {
                // Circuit or module already gone
            }

            _module = null;
        }

        _dotNetRef?.Dispose();
    }
}
