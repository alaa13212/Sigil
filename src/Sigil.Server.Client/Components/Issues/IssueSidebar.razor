@using Sigil.Application.Models.Issues
@using Sigil.Application.Models.IssueTrackers
@using Sigil.Domain
@inject IIssueService IssueService
@inject IIssueTrackerService IssueTrackerService
@inject ITagValueFormatter TagValueFormatter
@inject IReingestionService ReingestionService

<div class="w-full lg:w-72 space-y-4">
    
    <!-- Share button -->
    <button class="btn btn-info btn-outline w-full" @onclick="OpenShareModal">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        Share
    </button>

    <!-- Re-ingest button (admin only) -->
    <AuthorizeView Roles="Admin">
        <button class="btn btn-error btn-outline w-full btn-sm" @onclick="ShowReingestionConfirm" disabled="@_reingesting">
            @if (_reingesting)
            {
                <span class="loading loading-spinner loading-xs"></span>
            }
            Re-ingest Issue
        </button>
    </AuthorizeView>
    
    <!-- Status + Priority -->
    <div class="card bg-base-100">
        <div class="card-body p-0 divide-y divide-base-300">
            <!-- Status row -->
            <div class="dropdown dropdown-end w-full">
                <label tabindex="0" class="btn btn-ghost btn-sm w-full justify-between rounded-t-2xl rounded-b-none px-4 h-11" aria-disabled="@_loading">
                    <span class="text-sm opacity-60">Status</span>
                    <div class="flex items-center gap-1.5">
                        <StatusBadge Status="Issue.Status"/>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </div>
                </label>
                <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-box w-full shadow z-10 p-1">
                    @if (Issue.Status != IssueStatus.Open)
                    {
                        <li><button @onclick="() => UpdateStatus(IssueStatus.Open)" disabled="@_loading">Reopen</button></li>
                    }
                    @if (Issue.Status != IssueStatus.Resolved)
                    {
                        <li><button @onclick="() => UpdateStatus(IssueStatus.Resolved)" disabled="@_loading">Resolve</button></li>
                    }
                    @if (Issue.Status != IssueStatus.ResolvedInFuture)
                    {
                        <li><button @onclick="() => UpdateStatus(IssueStatus.ResolvedInFuture)" disabled="@_loading">Resolve in Next Release</button></li>
                    }
                    @if (Issue.Status != IssueStatus.Ignored)
                    {
                        <li><button @onclick="() => UpdateStatus(IssueStatus.Ignored)" disabled="@_loading">Ignore</button></li>
                        <li><button @onclick="() => UpdateStatusIgnoreFuture(IssueStatus.Ignored)" disabled="@_loading">Ignore + future events</button></li>
                    }
                </ul>
            </div>
            <!-- Priority row -->
            <div class="dropdown dropdown-end w-full">
                <label tabindex="0" class="btn btn-ghost btn-sm w-full justify-between rounded-b-2xl rounded-t-none px-4 h-11" aria-disabled="@_loading">
                    <span class="text-sm opacity-60">Priority</span>
                    <div class="flex items-center gap-1.5">
                        <span class="text-sm">@Issue.Priority</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </div>
                </label>
                <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-box w-full shadow z-10 p-1">
                    @foreach (var p in Enum.GetValues<Priority>())
                    {
                        <li><button @onclick="() => SetPriority(p)" disabled="@_loading" class="@(p == Issue.Priority ? "active" : "")">@p</button></li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Details -->
    <div class="card bg-base-100">
        <div class="card-body p-4 space-y-1 text-sm">
            <div class="flex justify-between">
                <span class="opacity-60">Severity</span>
                <SeverityBadge Level="Issue.Level"/>
            </div>
            <div class="flex justify-between">
                <span class="opacity-60">Assigned</span>
                <span>@(Issue.AssignedToName ?? "Unassigned")</span>
            </div>
            <div class="flex flex-col whitespace-nowrap">
                <div class="flex justify-between">
                    <span class="opacity-60">First Seen</span>
                    <RelativeTime Value="Issue.FirstSeen"/>
                </div>
                @if (!string.IsNullOrEmpty(Issue.FirstRelease))
                {
                    <div class="text-xs text-end opacity-50 font-mono truncate">@TagValueFormatter.Format("release", Issue.FirstRelease)</div>
                }
            </div>
            <div class="flex flex-col whitespace-nowrap">
                <div class="flex justify-between">
                    <span class="opacity-60">Last Seen</span>
                    <RelativeTime Value="Issue.LastSeen"/>
                </div>
                @if (!string.IsNullOrEmpty(Issue.LastRelease))
                {
                    <div class="text-xs text-end opacity-50 font-mono truncate">@TagValueFormatter.Format("release", Issue.LastRelease)</div>
                }
            </div>
            <div class="flex justify-between">
                <span class="opacity-60">Events</span>
                <span class="font-mono">@Issue.OccurrenceCount</span>
            </div>
            @if (_histogramError is not null)
            {
                <div class="flex items-center justify-between gap-2 text-xs text-error">
                    <span>@_histogramError</span>
                    <button class="btn btn-xs" @onclick="LoadHistogramAsync">Retry</button>
                </div>
            }
            else if (_histogram is not null)
            {
                <div class="pt-1">
                    <TimeSeriesChart Data="_histogram" Width="248" Height="140"
                                     RangeDays="RangeDays" Granularity="Granularity" Mode="Mode"
                                     StyledHover="false" ViewChanged="OnViewChanged" />
                </div>
            }
            @if (Issue.MergeSet is not null)
            {
                <div class="flex justify-between">
                    <span class="opacity-60">Merge Group</span>
                    <span class="font-mono">@Issue.MergeSet.Members.Count members</span>
                </div>
            }
        </div>
    </div>

    <!-- External Issue Links -->
    @if (_trackerError is not null)
    {
        <div class="flex items-center justify-between gap-2 text-xs text-error">
            <span>@_trackerError</span>
            <button class="btn btn-xs" @onclick="LoadTrackerConfigsAsync">Retry</button>
        </div>
    }
    @if (_trackerConfigs.Count > 0 || (Issue.ExternalLinks?.Count > 0))
    {
        <div class="card bg-base-100">
            <div class="card-body p-4 space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-semibold">Linked Issues</span>
                    @if (_trackerConfigs.Count > 0)
                    {
                        <div class="dropdown dropdown-end">
                            <label tabindex="0" class="btn btn-xs btn-ghost">+ Create Task</label>
                            <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-box shadow z-10 p-1 min-w-max">
                                @foreach (var cfg in _trackerConfigs)
                                {
                                    <li><button @onclick="() => OpenCreateTaskModal(cfg)">@cfg.TrackerType</button></li>
                                }
                            </ul>
                        </div>
                    }
                </div>
                @if (Issue.ExternalLinks?.Count > 0)
                {
                    @foreach (var link in Issue.ExternalLinks)
                    {
                        <div class="flex items-center justify-between text-xs">
                            <a href="@link.ExternalUrl" target="_blank" class="link link-hover font-mono truncate mr-2">
                                @link.TrackerType: @link.ExternalId
                            </a>
                            <div class="flex items-center gap-1 shrink-0">
                                @if (!string.IsNullOrEmpty(link.ExternalStatus))
                                {
                                    <span class="badge badge-xs">@link.ExternalStatus</span>
                                }
                                <button class="btn btn-ghost btn-xs text-error opacity-60" @onclick="() => UnlinkExternal(link.Id)">✕</button>
                            </div>
                        </div>
                    }
                }
                else if (_trackerConfigs.Count > 0)
                {
                    <p class="text-xs opacity-50">No linked issues.</p>
                }
            </div>
        </div>
    }

    <!-- Tags with frequency bars -->
    @{
        var systemTags = Issue.Tags.Where(t => SystemTags.IsSystemTag(t.Key)).ToList();
        var userTags = Issue.Tags.Where(t => !SystemTags.IsSystemTag(t.Key)).OrderBy(t => t.Key).ToList();
    }

    @if (systemTags.Count > 0)
    {
        <div class="card bg-base-100">
            <div class="card-body p-4 space-y-2">
                <span class="text-sm font-semibold">System Flags</span>
                <div class="flex flex-wrap gap-1">
                    @foreach (var tag in systemTags)
                    {
                        <span class="badge badge-sm badge-warning">@tag.Key[@SystemTags.Prefix.Length..]</span>
                    }
                </div>
            </div>
        </div>
    }

    @if (userTags.Count > 0)
    {
        <div class="card bg-base-100">
            <div class="card-body p-4 space-y-3">
                <span class="text-sm font-semibold">Tags</span>
                @foreach (var group in userTags)
                {
                    <div class="space-y-1">
                        <div class="text-xs font-semibold opacity-70">@group.Key</div>
                        @{
                            var topValues = group.Values.Take(4).ToList();
                            int othersCount = group.TotalCount - topValues.Sum(v => v.Count);
                        }
                        @foreach (var tagVal in topValues)
                        {
                            var pct = group.TotalCount > 0 ? (double)tagVal.Count / group.TotalCount * 100 : 0;
                            <div class="space-y-0.5">
                                <div class="flex justify-between text-xs">
                                    <span class="font-mono line-clamp-1" title="@tagVal.Value">
                                        <TagLink ProjectId="Issue.ProjectId" Key="@group.Key" Value="@tagVal.Value"/>
                                    </span>
                                    <span class="opacity-50 shrink-0 ml-2">@pct.ToString("F0")%</span>
                                </div>
                                <div class="w-full bg-base-300 rounded-full h-1">
                                    <div class="bg-primary rounded-full h-1" style="width: @pct.ToString("F1")%"></div>
                                </div>
                            </div>
                        }
                        @if (othersCount > 0)
                        {
                            var othersPct = (double)othersCount / group.TotalCount * 100;
                            <div class="space-y-0.5">
                                <div class="flex justify-between text-xs">
                                    <span class="opacity-50 italic">others</span>
                                    <span class="opacity-50 shrink-0 ml-2">@othersPct.ToString("F0")%</span>
                                </div>
                                <div class="w-full bg-base-300 rounded-full h-1">
                                    <div class="bg-base-content/20 rounded-full h-1" style="width: @othersPct.ToString("F1")%"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<ShareModal IssueId="Issue.Id" IsOpen="_showShareModal" OnClose="CloseShareModal" />
<CreateExternalIssueModal IsOpen="_showCreateTaskModal" Issue="Issue" TrackerConfig="_selectedTrackerConfig" OnClose="CloseCreateTaskModal" OnCreated="OnExternalIssueCreated" />

<ModalBase IsOpen="_showReingestionConfirm" Title="Confirm Re-ingestion" OnClose="HideReingestionConfirm">
    <p class="mb-2">This will re-process all events for this issue through the current rule set:</p>
    <ul class="list-disc list-inside text-sm space-y-1 mb-4 opacity-80">
        <li>Events matching inbound filters will be <strong>deleted</strong></li>
        <li>Events with changed fingerprints will be <strong>moved</strong> to a different issue</li>
        <li>Stack frames and culprits will be <strong>updated</strong> in place</li>
    </ul>
    <p class="text-error text-sm font-semibold mb-4">This operation cannot be undone.</p>
    <div class="modal-action">
        <button class="btn btn-ghost" @onclick="HideReingestionConfirm">Cancel</button>
        <button class="btn btn-error" @onclick="StartReingestion" disabled="@_reingesting">
            @if (_reingesting)
            {
                <span class="loading loading-spinner loading-sm"></span>
            }
            Re-ingest
        </button>
    </div>
</ModalBase>

@code {
    [Parameter, EditorRequired] public IssueDetailResponse Issue { get; set; } = default!;
    [Parameter] public EventCallback<IssueStatus> OnStatusChanged { get; set; }
    [Parameter] public EventCallback<Priority> OnPriorityChanged { get; set; }
    [Parameter] public EventCallback OnReingestionStarted { get; set; }
    [Parameter] public EventCallback OnLinksChanged { get; set; }

    /// <summary>Window the event activity chart shows, in days back from now.</summary>
    [Parameter] public int RangeDays { get; set; } = TimeSeriesChartView.DefaultRangeDays;

    /// <summary>Bucket width the chart requests; <c>Auto</c> derives it from <see cref="RangeDays"/>.</summary>
    [Parameter] public TimeSeriesGranularity Granularity { get; set; } = TimeSeriesGranularity.Auto;

    /// <summary>Bar or line + area.</summary>
    [Parameter] public TimeSeriesChartMode Mode { get; set; } = TimeSeriesChartMode.Bar;

    [Parameter] public EventCallback<TimeSeriesChartView> ViewChanged { get; set; }

    private bool _loading;
    private bool _reingesting;
    private TimeSeries? _histogram;
    private string? _histogramError;
    private (int IssueId, int RangeDays, TimeSeriesGranularity Granularity)? _histogramKey;
    private string? _trackerError;

    private bool _showShareModal;
    private bool _showReingestionConfirm;
    private bool _showCreateTaskModal;
    private IssueTrackerConfigResponse? _selectedTrackerConfig;
    private List<IssueTrackerConfigResponse> _trackerConfigs = [];

    protected override async Task OnParametersSetAsync()
    {
        var key = (Issue.Id, RangeDays, Granularity);
        if (_histogramKey != key || (_histogram is null && _histogramError is null))
        {
            _histogramKey = key;
            await LoadHistogramAsync();
        }

        await LoadTrackerConfigsAsync();
    }

    private async Task LoadHistogramAsync()
    {
        _histogramError = null;
        try { _histogram = await IssueService.GetHistogramAsync(Issue.Id, RangeDays, Granularity); }
        catch (Exception ex) when (ex is HttpRequestException or ArgumentException)
        {
            _histogram = null;
            _histogramError = "Could not load the event activity chart.";
        }
    }

    private async Task LoadTrackerConfigsAsync()
    {
        _trackerError = null;
        try { _trackerConfigs = await IssueTrackerService.GetConfigsAsync(Issue.ProjectId); }
        catch (Exception ex) when (ex is HttpRequestException or ArgumentException)
        {
            _trackerConfigs = [];
            _trackerError = "Could not load linked issues.";
        }
    }

    private Task OnViewChanged(TimeSeriesChartView view) => ViewChanged.InvokeAsync(view);

    private void OpenCreateTaskModal(IssueTrackerConfigResponse cfg)
    {
        _selectedTrackerConfig = cfg;
        _showCreateTaskModal = true;
    }

    private void CloseCreateTaskModal() => _showCreateTaskModal = false;

    private async Task OnExternalIssueCreated()
    {
        _showCreateTaskModal = false;
        await OnLinksChanged.InvokeAsync();
    }

    private async Task UnlinkExternal(int linkId)
    {
        await IssueTrackerService.UnlinkAsync(Issue.ProjectId, linkId);
        Issue.ExternalLinks?.RemoveAll(l => l.Id == linkId);
        await OnLinksChanged.InvokeAsync();
    }

    private async Task UpdateStatus(IssueStatus status)
    {
        _loading = true;
        try
        {
            await IssueService.UpdateIssueStatusAsync(Issue.Id, status);
            await OnStatusChanged.InvokeAsync(status);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UpdateStatusIgnoreFuture(IssueStatus status)
    {
        _loading = true;
        try
        {
            await IssueService.UpdateIssueStatusAsync(Issue.Id, status, ignoreFutureEvents: true);
            await OnStatusChanged.InvokeAsync(status);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetPriority(Priority priority)
    {
        _loading = true;
        try
        {
            await IssueService.UpdateIssuePriorityAsync(Issue.Id, priority);
            await OnPriorityChanged.InvokeAsync(priority);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenShareModal() => _showShareModal = true;
    private void CloseShareModal() => _showShareModal = false;

    private void ShowReingestionConfirm() => _showReingestionConfirm = true;
    private void HideReingestionConfirm() => _showReingestionConfirm = false;

    private async Task StartReingestion()
    {
        _reingesting = true;
        _showReingestionConfirm = false;
        try
        {
            await ReingestionService.StartIssueReingestionAsync(Issue.Id);
            await OnReingestionStarted.InvokeAsync();
        }
        catch
        {
            // Conflict or error — silently ignore
        }
        finally
        {
            _reingesting = false;
        }
    }
}
