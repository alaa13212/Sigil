@page "/projects/{ProjectId:int}/issues"
@attribute [Authorize]
@implements IShortcutTarget
@implements IDisposable
@using System.Web
@using Sigil.Application.Input
@using Sigil.Application.Models.Shared
@using Sigil.Application.Models.Issues
@using Sigil.Application.Models.Teams
@using Sigil.Domain
@using Sigil.Server.Client.Services
@inject IIssueService IssueService
@inject IBookmarkService BookmarkService
@inject IRecommendationService RecommendationService
@inject IProjectService ProjectService
@inject ITeamService TeamService
@inject ShortcutTargetRegistry ShortcutTargets
@inject NavigationManager Navigation

<PageTitle>Issues — Sigil</PageTitle>

<PageBreadcrumb Items="@([ new PageBreadcrumb.BreadcrumbItem("Projects", "/"), new PageBreadcrumb.BreadcrumbItem("Issues") ])" />

<!-- Recommendations banner -->
@if (recommendationCount > 0)
{
    <div class="alert alert-warning shadow-sm mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
        </svg>
        <span>
            <strong>@recommendationCount @(recommendationCount == 1 ? "recommendation" : "recommendations")</strong>
            to improve your error tracking setup.
        </span>
        <a href="@($"/projects/{ProjectId}/issues/recommendations")" class="btn btn-sm btn-warning">View</a>
    </div>
}

<div class="bg-base-100 p-4 space-y-4">


    <!-- Header -->
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold">Issues</h1>
        @if (Response is not null)
        {
            <span class="text-sm opacity-60">@Response.TotalCount total</span>
        }
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap gap-2 items-center">
        <!-- Status tabs -->
        <form >
            <input class="btn btn-sm btn-square @(StatusFilter == null ? "bg-primary" : "")" type="reset" value="All" @onclick="() => SetStatusFilter(null)"/>
            @foreach (var s in statusOptions)
            {
                <input class="btn btn-sm" type="radio" name="status" checked="@(StatusFilter == s.Value)" @onclick="() => SetStatusFilter(s.Value)" aria-label="@s.Label"/>
            }
        </form>
        
        <!-- Bookmarked filter -->
        <button class="btn btn-sm @(BookmarkedParam is true ? "btn-warning" : "")"
                @onclick="ToggleBookmarkedFilter" title="@(BookmarkedParam is true ? "Showing bookmarked" : "Show bookmarked")">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="@(BookmarkedParam is true ? "currentColor" : "none")" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
        </button>

        <!-- Severity filter -->
        <label class="select select-sm w-48">
            <span class="label">Severity</span>
            <select value="@(LevelParam?.ToString() ?? "")" @onchange="OnLevelChanged">
                <option value="">All</option>
                @foreach (Severity sev in Enum.GetValues<Severity>())
                {
                    <option value="@sev">@sev</option>
                }
            </select>
        </label>

        <!-- Sort -->
        <label class="select select-sm w-48">
            <span class="label">Sort @(SortDescending ? "▼" : "▲")</span>
            <select value="@Sort" @onchange="OnSortChanged">
                @foreach (var opt in sortOptions)
                {
                    <option value="@opt.Value">@opt.Label</option>
                }
            </select>
        </label>
        
        <!-- Search -->
        <form class="flex-1 min-w-48" @onsubmit="ApplySearch" @onsubmit:preventDefault>
            <input type="text" placeholder="Search issues..." class="input input-sm w-full"
                   @bind="searchText" @bind:event="oninput" />
        </form>
    </div>

    <!-- Date range -->
    <DateRangePicker Since="SinceParam" Until="UntilParam" RangeChanged="OnRangeChanged" />

    <!-- Active filter chips -->
    <ActiveFilterChips Chips="ActiveChips" Dismissed="DismissChip" />

    <!-- Content -->
    @if (loading)
    {
        <div class="flex justify-center py-16">
            <span class="loading loading-spinner loading-lg"></span>
        </div>
    }
    else if (loadError is not null)
    {
        <div class="alert alert-error">
            <span>@loadError</span>
            <button class="btn btn-sm" @onclick="LoadIssues">Retry</button>
        </div>
    }
    else if (projectNotFound)
    {
        <EmptyState Title="Project not found" Description="This project does not exist or you do not have access to it." />
    }
    else if (Response is null || Response.Items.Count == 0)
    {
        <EmptyState Title="No issues found" Description="Try adjusting your filters or wait for events to come in." />
    }
    else
    {
        <fieldset class="fieldset" disabled="@(!HasSelection)">
            <div class="flex flex-wrap items-center gap-2 p-3 bg-base-200 rounded-lg">
                <span class="text-sm font-medium">@_selected.Count selected</span>

                <button type="button" class="btn btn-primary btn-sm" @onclick="() => RunBulkStatus(IssueStatus.Resolved)">Resolve</button>
                <button type="button" class="btn btn-sm" @onclick="() => RunBulkStatus(IssueStatus.Ignored)">Ignore</button>
                <button type="button" class="btn btn-sm" @onclick="() => RunBulkStatus(IssueStatus.Ignored, true)">Ignore + future events</button>
                <button type="button" class="btn btn-sm" @onclick="RunBulkBookmark">Bookmark</button>

                <select class="select select-sm w-48" @onchange="OnAssigneeChanged">
                    <option value="">Assign to…</option>
                    @foreach (var member in _assignees)
                    {
                        <option value="@member.UserId">@(member.DisplayName ?? member.Email ?? "Unnamed member")</option>
                    }
                </select>
                <button type="button" class="btn btn-sm" @onclick="RunBulkAssign" disabled="@(!HasAssignee)">Assign</button>
                <button type="button" class="btn btn-sm" @onclick="RunBulkUnassign">Unassign</button>

                <button type="button" class="btn btn-ghost btn-sm" @onclick="ClearSelection">Clear</button>

                @if (!string.IsNullOrEmpty(_bulkError))
                {
                    <span class="text-sm text-error">@_bulkError</span>
                }
            </div>
        </fieldset>

        <div class="overflow-x-auto">
            <table class="table table-zebra table-sm">
                <thead>
                    <tr>
                        <th class="w-8">
                            <input type="checkbox" class="checkbox checkbox-sm"
                                   checked="@AllOnPageSelected"
                                   @onchange="e => ToggleSelectAll((bool)(e.Value ?? false))"
                                   title="Select every issue on this page" />
                        </th>
                        <th class="w-8"></th>
                        <th>Issue</th>
                        <SortableHeader Label="Severity"
                                        Active="@(Sort == IssueSortBy.Level)"
                                        Descending="@SortDescending"
                                        Disabled="@SearchHasFreeText"
                                        Title="@SortTitle"
                                        OnClick="@(() => ToggleSort(IssueSortBy.Level))" />
                        <th>Status</th>
                        <SortableHeader Label="Priority"
                                        Active="@(Sort == IssueSortBy.Priority)"
                                        Descending="@SortDescending"
                                        Disabled="@SearchHasFreeText"
                                        Title="@SortTitle"
                                        OnClick="@(() => ToggleSort(IssueSortBy.Priority))" />
                        <SortableHeader Label="Events" Class="text-right"
                                        Active="@(Sort == IssueSortBy.OccurrenceCount)"
                                        Descending="@SortDescending"
                                        Disabled="@SearchHasFreeText"
                                        Title="@SortTitle"
                                        OnClick="@(() => ToggleSort(IssueSortBy.OccurrenceCount))" />
                        <th class="w-28">Last 14d</th>
                        <SortableHeader Label="Last Seen"
                                        Active="@(Sort == IssueSortBy.LastSeen)"
                                        Descending="@SortDescending"
                                        Disabled="@SearchHasFreeText"
                                        Title="@SortTitle"
                                        OnClick="@(() => ToggleSort(IssueSortBy.LastSeen))" />
                        <th>Assigned</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var issue in Response.Items)
                    {
                        var isMerged = issue.MergeSetId.HasValue;
                        var targetUrl = $"/projects/{ProjectId}/issues/{issue.Id}";
                        var isBookmarked = bookmarkedIssueIds.Contains(issue.Id);
                        <tr id="@($"issue-row-{issue.Id}")" class="hover:bg-base-300 relative @(_selected.Contains(issue.Id) ? "bg-primary/5" : "") @FocusRowClass(issue.Id)">
                            <td @onclick:stopPropagation="true">
                                <input type="checkbox" class="checkbox checkbox-sm"
                                       checked="@_selected.Contains(issue.Id)"
                                       @onchange="e => ToggleSelect(issue.Id, (bool)(e.Value ?? false))" />
                            </td>
                            <td @onclick:stopPropagation="true">
                                <button class="btn btn-ghost btn-xs p-0" @onclick="() => ToggleIssueBookmark(issue.Id)"
                                        title="@(isBookmarked ? "Remove bookmark" : "Bookmark")">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 @(isBookmarked ? "text-warning" : "opacity-30")"
                                         fill="@(isBookmarked ? "currentColor" : "none")" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                                    </svg>
                                </button>
                            </td>
                            <td>
                                <a href="@targetUrl" class="stretched-link after:start-20! cursor-pointer"></a>
                                <div class="font-semibold flex items-center gap-1.5">
                                    @if (issue.IsUnviewed)
                                    {
                                        <span class="w-2 h-2 rounded-full bg-primary shrink-0" title="New activity since your last visit"></span>
                                    }
                                    @if (isMerged && issue.MergeSetSize > 1)
                                    {
                                        <!-- Stacked layers icon for merged issues -->
                                        <span class="badge badge-sm badge-neutral gap-1" title="Merged issue group (@issue.MergeSetSize members)">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                            </svg>
                                            @issue.MergeSetSize
                                        </span>
                                    }
                                    @if (issue.SystemTagKeys is not null)
                                    {
                                        @foreach (var tagKey in issue.SystemTagKeys)
                                        {
                                            var label = tagKey[SystemTags.Prefix.Length..];
                                            var css = tagKey == SystemTags.Regression ? "badge-error"
                                                    : tagKey == SystemTags.HighVolume  ? "badge-info"
                                                    : "badge-warning";
                                            <span class="badge badge-sm text-nowrap @css">@label</span>
                                        }
                                    }
                                    @if (!string.IsNullOrEmpty(issue.ExceptionType))
                                    {
                                        <span class="opacity-80">@issue.ExceptionType: </span>
                                    }
                                    @if (!string.IsNullOrEmpty(issue.Title))
                                    {
                                        <p class="line-clamp-1">@issue.Title</p>
                                    }
                                    else
                                    {
                                        <p class="line-clamp-1 opacity-50 italic">No message</p>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(issue.Culprit))
                                {
                                    <div class="text-xs opacity-60">@issue.Culprit</div>
                                }
                            </td>
                            <td><SeverityBadge Level="issue.Level" /></td>
                            <td><StatusBadge Status="issue.Status" /></td>
                            <td class="text-sm @(@issue.Priority == Priority.Low? "opacity-70" : "")">@issue.Priority</td>
                            <td class="text-right font-mono">@issue.OccurrenceCount</td>
                            <td class="opacity-60">
                                @if (_histograms.TryGetValue(issue.Id, out var hist))
                                {
                                    <Sparkline Data="hist" Width="100" Height="20" />
                                }
                            </td>
                            <td><RelativeTime Value="issue.LastSeen" /></td>
                            <td class="text-sm opacity-70">@(issue.AssignedToName ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pagination Page="currentPage" TotalCount="Response.TotalCount" PageSize="PageSize"/>
    }
</div>

@if (_toast is not null)
{
    <div class="toast toast-end z-50">
        <div class="alert alert-success shadow-sm">
            <span class="text-sm">@_toast</span>
            @if (_toastUndoIssueId is { } undoIssueId)
            {
                <button type="button" class="btn btn-xs btn-ghost" @onclick="() => UndoResolveAsync(undoIssueId)">Undo</button>
            }
            <button type="button" class="btn btn-xs btn-ghost btn-circle" @onclick="DismissToast">×</button>
        </div>
    </div>
}

@code {
    [Parameter] public int ProjectId { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int PageParam { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "q")] public string? SearchParam { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? StatusParam { get; set; }
    [SupplyParameterFromQuery(Name = "bookmarked")] public bool? BookmarkedParam { get; set; }
    [SupplyParameterFromQuery(Name = "level")] public string? LevelQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "dir")] public string? DirectionQuery { get; set; }
    [SupplyParameterFromQuery(Name = "since")] public string? SinceQuery { get; set; }
    [SupplyParameterFromQuery(Name = "until")] public string? UntilQuery { get; set; }

    private Severity? LevelParam
    {
        get => QueryValue.Enum<Severity>(LevelQuery);
        set => LevelQuery = value?.ToString();
    }

    private IssueSortBy? SortParam
    {
        get => QueryValue.Enum<IssueSortBy>(SortQuery);
        set => SortQuery = value?.ToString();
    }

    private IssueSortDirection? DirectionParam
    {
        get => QueryValue.Enum<IssueSortDirection>(DirectionQuery);
        set => DirectionQuery = value?.ToString();
    }

    private DateTimeOffset? SinceParam
    {
        get => QueryValue.Instant(SinceQuery);
        set => SinceQuery = QueryValue.Format(value);
    }

    private DateTimeOffset? UntilParam
    {
        get => QueryValue.Instant(UntilQuery);
        set => UntilQuery = QueryValue.Format(value);
    }

    private const int PageSize = 50;
    private const string AllStatuses = "all";
    private const IssueStatus DefaultStatus = IssueStatus.Open;

    [PersistentState] public PagedResponse<IssueSummary>? Response { get; set; }
    private bool loading = true;
    private string? loadError;
    private bool projectNotFound;
    private int currentPage = 1;
    private string _lastQueryState = ""; // track URL filter state to detect changes
    private string? _lastSearchParam; // track URL search to detect changes

    // Filters
    private string searchText = "";
    
    /// <summary>Status filter: a missing parameter means the default, "all" means no status filter.</summary>
    private IssueStatus? StatusFilter => StatusParam switch
    {
        null => DefaultStatus,
        _ when string.Equals(StatusParam, AllStatuses, StringComparison.OrdinalIgnoreCase) => null,
        _ when Enum.TryParse<IssueStatus>(StatusParam, out var parsed) => parsed,
        _ => DefaultStatus,
    };

    private IssueSortBy Sort => SortParam ?? IssueSortBy.LastSeen;

    private bool SortDescending => DirectionParam is not IssueSortDirection.Ascending;

    private bool SearchHasFreeText => !string.IsNullOrWhiteSpace(IssueSearchParser.Parse(SearchParam).FreeText);

    private string SortTitle => SearchHasFreeText
        ? "Search results are ranked by relevance, not by this column."
        : "Sort by this column.";

    /// <summary>One chip per filter the listing is showing.</summary>
    private IReadOnlyList<ActiveFilterChip> ActiveChips => IssueFilterChips.Describe(
        new IssueFilterState(StatusFilter, LevelParam, SortParam, BookmarkedParam is true,
            SinceParam, UntilParam, SearchParam, DirectionParam),
        DefaultStatus,
        DateTimeOffset.UtcNow);

    // Bookmark state: IDs of bookmarked issues in the current page
    private HashSet<int> bookmarkedIssueIds = [];
    private Guid currentUserId;

    // Bulk selection: IDs of the issues ticked on the current page
    private HashSet<int> _selected = [];
    private string? _bulkError;
    private bool _assigneesLoaded;
    private List<TeamMemberResponse> _assignees = [];
    private Guid? _assigneeId;

    // Keyboard focus: the row the shortcuts act on
    private readonly ListFocusState _focus = new();
    private string? _toast;
    private int? _toastUndoIssueId;
    private System.Timers.Timer? _toastTimer;

    private bool HasSelection => _selected.Count > 0;

    private bool HasAssignee => _assigneeId.HasValue;

    private bool AllOnPageSelected =>
        Response is not null && Response.Items.Count > 0 && Response.Items.All(issue => _selected.Contains(issue.Id));

    // Histograms: issueId → daily event counts for last 14 days
    private Dictionary<int, TimeSeries> _histograms = [];

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    private int recommendationCount;

    private static readonly (string Label, IssueStatus? Value)[] statusOptions =
    [
        ("Open", IssueStatus.Open),
        ("Resolved", IssueStatus.Resolved),
        ("Next Release", IssueStatus.ResolvedInFuture),
        ("Ignored", IssueStatus.Ignored),
    ];

    private static readonly (string Label, IssueSortBy Value)[] sortOptions =
    [
        ("Last Seen", IssueSortBy.LastSeen),
        ("First Seen", IssueSortBy.FirstSeen),
        ("Occurrences", IssueSortBy.OccurrenceCount),
        ("Severity", IssueSortBy.Level),
        ("Priority", IssueSortBy.Priority),
    ];

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthState;
        var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        currentUserId = userIdStr is not null ? Guid.Parse(userIdStr) : Guid.Empty;

        currentPage = Math.Max(1, PageParam);

        // Sync searchText from URL on navigation (e.g. from a TagLink click)
        if (SearchParam != _lastSearchParam)
        {
            _lastSearchParam = SearchParam;
            searchText = SearchParam ?? "";
        }

        var queryState = BuildFilterUrl();
        if (Response is not null && queryState == _lastQueryState)
        {
            loading = false;
            return;
        }
        _lastQueryState = queryState;
        _selected.Clear();
        _focus.Reset();

        await LoadIssues();
        StateHasChanged();
        recommendationCount = await RecommendationService.GetRecommendationCountAsync(ProjectId);
    }

    private async Task LoadIssues()
    {
        loading = true;
        loadError = null;
        try
        {
            var query = new IssueQueryParams
            {
                Status = StatusFilter,
                Level = LevelParam,
                SortBy = Sort,
                SortDescending = SortDescending,
                Search = string.IsNullOrWhiteSpace(SearchParam) ? null : SearchParam,
                Since = SinceParam,
                Until = UntilParam,
                Page = currentPage,
                PageSize = PageSize,
                Bookmarked = BookmarkedParam is true
            };

            Response = await IssueService.GetIssueSummariesAsync(ProjectId, query);
            _focus.ClampTo(Response.Items.Count);

            // Load histograms in background (fire and don't block UI)
            _ = LoadHistogramsAsync(Response.Items.Select(i => i.Id).ToList());

            // Load bookmark states for visible issues
            var bookmarked = await BookmarkService.GetBookmarkedIssuesAsync(currentUserId);
            bookmarkedIssueIds = bookmarked.Select(i => i.Id).ToHashSet();
            projectNotFound = false;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            projectNotFound = true;
            Response = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or ArgumentException)
        {
            Response = null;
            loadError = ex is ArgumentException ? ex.Message : "Could not load issues. The request failed.";
        }
        finally
        {
            loading = false;
        }
    }

    private void SetStatusFilter(IssueStatus? status)
    {
        StatusParam = status?.ToString() ?? AllStatuses;
        NavigateToFilters();
    }

    private void OnLevelChanged(ChangeEventArgs e)
    {
        LevelParam = Enum.TryParse<Severity>(e.Value?.ToString(), out var level) ? level : null;
        NavigateToFilters();
    }

    private void OnSortChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<IssueSortBy>(e.Value?.ToString(), out var sort))
        {
            SortParam = sort == IssueSortBy.LastSeen ? null : sort;
            DirectionParam = null;
            NavigateToFilters();
        }
    }

    private void ToggleSort(IssueSortBy sort)
    {
        if (Sort == sort)
        {
            DirectionParam = SortDescending ? IssueSortDirection.Ascending : null;
        }
        else
        {
            SortParam = sort == IssueSortBy.LastSeen ? null : sort;
            DirectionParam = null;
        }

        NavigateToFilters();
    }

    private void OnRangeChanged(DateRange range)
    {
        SinceParam = range.Since;
        UntilParam = range.Until;
        NavigateToFilters();
    }

    private void ApplySearch()
    {
        SearchParam = string.IsNullOrWhiteSpace(searchText) ? null : searchText;
        NavigateToFilters();
    }

    private void ToggleBookmarkedFilter()
    {
        BookmarkedParam = BookmarkedParam is not true;
        NavigateToFilters();
    }

    private void RemoveTagFilter(string key, string value)
    {
        var next = IssueSearchParser.RemoveToken(SearchParam, key, value);
        SearchParam = string.IsNullOrWhiteSpace(next) ? null : next;
        NavigateToFilters();
    }

    private void DismissChip(ActiveFilterChip chip)
    {
        switch (chip.Kind)
        {
            case ActiveFilterKind.Status:
                SetStatusFilter(null);
                break;
            case ActiveFilterKind.Level:
                LevelParam = null;
                NavigateToFilters();
                break;
            case ActiveFilterKind.Sort:
                SortParam = null;
                DirectionParam = null;
                NavigateToFilters();
                break;
            case ActiveFilterKind.Bookmarked:
                BookmarkedParam = null;
                NavigateToFilters();
                break;
            case ActiveFilterKind.DateRange:
                OnRangeChanged(DateRange.Empty);
                break;
            case ActiveFilterKind.SearchToken:
                RemoveTagFilter(chip.Key!, chip.Value!);
                break;
        }
    }

    private void NavigateToFilters()
    {
        PageParam = 1;
        Navigation.NavigateTo(BuildFilterUrl(), forceLoad: false);
    }

    private string BuildFilterUrl()
    {
        var qs = HttpUtility.ParseQueryString(string.Empty);
        qs["page"] = Math.Max(1, PageParam).ToString();
        if (!string.IsNullOrWhiteSpace(SearchParam)) qs["q"] = SearchParam;
        if (StatusParam is { } rawStatus) qs["status"] = rawStatus;
        if (LevelParam is { } level) qs["level"] = level.ToString();
        if (SortParam is { } sort) qs["sort"] = sort.ToString();
        if (DirectionParam is { } direction) qs["dir"] = direction.ToString();
        if (BookmarkedParam is true) qs["bookmarked"] = "true";
        if (SinceParam is { } since) qs["since"] = UtcDateRangeInput.ToQueryValue(since);
        if (UntilParam is { } until) qs["until"] = UtcDateRangeInput.ToQueryValue(until);
        return $"/projects/{ProjectId}/issues?{qs}";
    }

    private async Task LoadHistogramsAsync(List<int> issueIds)
    {
        try
        {
            _histograms = await IssueService.GetBulkHistogramsAsync(issueIds);
            StateHasChanged();
        }
        catch (Exception ex) when (ex is HttpRequestException or ArgumentException)
        {
            // the sparkline column stays empty
        }
    }

    private async Task ToggleIssueBookmark(int issueId)
    {
        var isNowBookmarked = await BookmarkService.ToggleBookmarkAsync(issueId, currentUserId);
        if (isNowBookmarked)
            bookmarkedIssueIds.Add(issueId);
        else
        {
            bookmarkedIssueIds.Remove(issueId);
            if (BookmarkedParam is true)
                await LoadIssues();
        }
    }

    private async Task ToggleSelect(int issueId, bool selected)
    {
        if (selected)
            _selected.Add(issueId);
        else
            _selected.Remove(issueId);

        await EnsureAssigneesAsync();
    }

    private async Task ToggleSelectAll(bool selected)
    {
        if (Response is null) return;

        foreach (var issue in Response.Items)
        {
            if (selected)
                _selected.Add(issue.Id);
            else
                _selected.Remove(issue.Id);
        }

        await EnsureAssigneesAsync();
    }

    private void ClearSelection()
    {
        _selected.Clear();
        _bulkError = null;
    }

    private void OnAssigneeChanged(ChangeEventArgs e)
    {
        _assigneeId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
    }

    private Task RunBulkStatus(IssueStatus status, bool ignoreFutureEvents = false) =>
        RunBulk(new BulkIssueActionRequest(_selected.ToList(), Status: status, IgnoreFutureEvents: ignoreFutureEvents));

    private Task RunBulkBookmark() =>
        RunBulk(new BulkIssueActionRequest(_selected.ToList(), Bookmarked: true));

    private Task RunBulkAssign() =>
        RunBulk(new BulkIssueActionRequest(_selected.ToList(), AssignToUserId: _assigneeId));

    private Task RunBulkUnassign() =>
        RunBulk(new BulkIssueActionRequest(_selected.ToList(), Unassign: true));

    private async Task RunBulk(BulkIssueActionRequest request)
    {
        _bulkError = null;
        try
        {
            await IssueService.BulkUpdateIssuesAsync(ProjectId, request, currentUserId);
            await LoadIssues();
            _selected.Clear();
        }
        catch (HttpRequestException ex)
        {
            _bulkError = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to change these issues.",
                System.Net.HttpStatusCode.BadRequest => ex.Message,
                _ => "The bulk action failed.",
            };
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _bulkError = ex.Message;
        }
    }

    private async Task EnsureAssigneesAsync()
    {
        if (_assigneesLoaded || !HasSelection) return;
        _assigneesLoaded = true;

        try
        {
            var project = await ProjectService.GetProjectDetailAsync(ProjectId);
            if (project?.TeamId is not { } teamId) return;

            var team = await TeamService.GetTeamDetailAsync(teamId);
            _assignees = team?.Members ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or ArgumentException)
        {
            _assignees = [];
        }
    }

    protected override void OnInitialized() => ShortcutTargets.Register(this);

    public void Dispose()
    {
        ShortcutTargets.Unregister(this);
        _toastTimer?.Dispose();
    }

    public async Task<string?> MoveFocusAsync(int delta)
    {
        if (Response is null) return null;

        _focus.Move(delta, Response.Items.Count);
        await InvokeAsync(StateHasChanged);

        return FocusedRowId();
    }

    public async Task<bool> ResolveFocusedAsync()
    {
        if (Response is null || !_focus.HasFocus) return false;

        var issue = Response.Items[_focus.Index];
        await IssueService.UpdateIssueStatusAsync(issue.Id, IssueStatus.Resolved);
        await LoadIssues();
        ShowToast($"Issue #{issue.Id} resolved", issue.Id);
        await InvokeAsync(StateHasChanged);

        return true;
    }

    private string? FocusedRowId()
    {
        if (Response is null || !_focus.HasFocus || _focus.Index >= Response.Items.Count) return null;

        return $"issue-row-{Response.Items[_focus.Index].Id}";
    }

    private string FocusRowClass(int issueId)
    {
        if (Response is null || !_focus.HasFocus || _focus.Index >= Response.Items.Count) return "";

        return Response.Items[_focus.Index].Id == issueId ? "bg-base-300" : "";
    }

    private void ShowToast(string message, int? undoIssueId = null)
    {
        _toast = message;
        _toastUndoIssueId = undoIssueId;

        _toastTimer?.Stop();
        _toastTimer?.Dispose();
        _toastTimer = new System.Timers.Timer(8000) { AutoReset = false };
        _toastTimer.Elapsed += async (_, _) => await InvokeAsync(() =>
        {
            _toast = null;
            _toastUndoIssueId = null;
            StateHasChanged();
        });
        _toastTimer.Start();
    }

    private void DismissToast()
    {
        _toast = null;
        _toastUndoIssueId = null;
        _toastTimer?.Stop();
    }

    private async Task UndoResolveAsync(int issueId)
    {
        await IssueService.UpdateIssueStatusAsync(issueId, IssueStatus.Open);
        await LoadIssues();
        DismissToast();
    }
}
