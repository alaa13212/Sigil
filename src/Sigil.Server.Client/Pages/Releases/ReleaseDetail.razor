@page "/projects/{ProjectId:int}/releases/{ReleaseId:int}"
@attribute [Authorize]
@using Sigil.Application.Models.Releases
@using Sigil.Application.Models.SourceCode
@using Sigil.Application.Models.Shared
@inject IReleaseHealthService ReleaseHealthService
@inject IIssueService IssueService
@inject ISourceCodeService SourceCodeSvc

<PageTitle>Release — Sigil</PageTitle>

<PageBreadcrumb Items="@([ new PageBreadcrumb.BreadcrumbItem("Projects", "/"), new PageBreadcrumb.BreadcrumbItem("Releases", $"/projects/{ProjectId}/releases"), new PageBreadcrumb.BreadcrumbItem(release?.RawName ?? "…") ])" />

@if (loading)
{
    <div class="flex justify-center py-12"><span class="loading loading-spinner loading-lg"></span></div>
}
else if (loadError is not null)
{
    <div class="alert alert-error">
        <span>@loadError</span>
        <button class="btn btn-sm" @onclick="LoadReleaseAsync">Retry</button>
    </div>
}
else if (release is null)
{
    <EmptyState Title="Release not found" Description="This release may have been removed or the link is invalid." />
}
else
{
    <div class="space-y-6">
        <div class="flex items-start justify-between">
            <div>
                <h1 class="text-2xl font-bold font-mono">@release.RawName</h1>
                @if (!string.IsNullOrEmpty(release.SemanticVersion) && release.SemanticVersion != release.RawName)
                {
                    <div class="text-sm opacity-50 mt-0.5">@release.SemanticVersion</div>
                }
                @if (!string.IsNullOrEmpty(release.Package))
                {
                    <div class="text-sm opacity-50">@release.Package</div>
                }
            </div>

            @if (!string.IsNullOrEmpty(release.CommitSha))
            {
                @if (commitInfo != null)
                {
                    <div class="text-right space-y-1">
                        @if (commitInfo.Url != null)
                        {
                            <a href="@commitInfo.Url" target="_blank" class="badge badge-outline font-mono text-xs hover:badge-primary">
                                @release.CommitSha[..Math.Min(7, release.CommitSha.Length)] ↗
                            </a>
                        }
                        else
                        {
                            <div class="badge badge-outline font-mono text-xs">@release.CommitSha[..Math.Min(7, release.CommitSha.Length)]</div>
                        }
                        @if (!string.IsNullOrEmpty(commitInfo.Message))
                        {
                            <div class="text-xs opacity-60 max-w-xs truncate" title="@commitInfo.Message">
                                @commitInfo.Message.Split('\n')[0]
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(commitInfo.AuthorName))
                        {
                            <div class="text-xs opacity-50">by @commitInfo.AuthorName</div>
                        }
                    </div>
                }
                else
                {
                    <div class="badge badge-outline font-mono text-xs">@release.CommitSha[..Math.Min(7, release.CommitSha.Length)]</div>
                }
            }
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="stat bg-base-100 rounded-box p-4">
                <div class="stat-title">Total Events</div>
                <div class="stat-value text-2xl">@release.TotalEvents.ToString("N0")</div>
            </div>
            <div class="stat bg-base-100 rounded-box p-4">
                <div class="stat-title">Affected Issues</div>
                <div class="stat-value text-2xl">@release.AffectedIssues.ToString("N0")</div>
            </div>
            <div class="stat bg-base-100 rounded-box p-4">
                <div class="stat-title">New Issues</div>
                <div class="stat-value text-2xl @(release.NewIssues > 0 ? "text-error" : "")">@release.NewIssues.ToString("N0")</div>
            </div>
            <div class="stat bg-base-100 rounded-box p-4">
                <div class="stat-title">First Seen</div>
                <div class="stat-value text-base"><RelativeTime Value="release.FirstSeenAt" /></div>
            </div>
        </div>

        @if (_releaseHistogram is not null)
        {
            <div class="card bg-base-100">
                <div class="card-body p-4">
                    <h2 class="card-title text-base mb-2">Event Activity</h2>
                    <TimeSeriesChart Data="_releaseHistogram" Width="560" Height="180"
                                     RangeDays="ChartView.RangeDays" Granularity="ChartView.Granularity" Mode="ChartView.Mode"
                                     ViewChanged="OnChartViewChanged" />
                </div>
            </div>
        }

        @if (release.TopIssues.Count > 0)
        {
            <div class="card bg-base-100">
                <div class="card-body p-4">
                    <h2 class="card-title text-base mb-2">Top Issues</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Issue</th>
                                <th class="text-right">Events</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var issue in release.TopIssues.OrderByDescending(i => i.IsNew))
                            {
                                <tr class="relative hover cursor-pointer @(issue.IsNew ? "bg-error/5 border-l-2 border-error" : "")">
                                    <td>
                                        <a class="flex items-center gap-2 stretched-link" href="/projects/@ProjectId/issues/@issue.IssueId">
                                            @if (issue.IsNew)
                                            {
                                                <span class="badge badge-sm badge-error">New</span>
                                            }
                                            <SeverityBadge Level="issue.Level" />
                                            <div>
                                                <div class="font-medium text-sm line-clamp-1">@issue.Title</div>
                                                @if (!string.IsNullOrEmpty(issue.ExceptionType))
                                                {
                                                    <div class="text-xs opacity-50 font-mono">@issue.ExceptionType</div>
                                                }
                                            </div>
                                        </a>
                                    </td>
                                    <td class="text-right font-mono text-sm">@issue.EventCount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public int ReleaseId { get; set; }
    [SupplyParameterFromQuery(Name = ChartQueryState.RangeKey)] public int? RangeParam { get; set; }
    [SupplyParameterFromQuery(Name = ChartQueryState.BucketsKey)] public TimeSeriesGranularity? BucketsParam { get; set; }
    [SupplyParameterFromQuery(Name = ChartQueryState.ChartKey)] public TimeSeriesChartMode? ChartModeParam { get; set; }

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    /// <summary>Range, bucket width and style selected on the event activity chart.</summary>
    private TimeSeriesChartView ChartView => new(
        RangeParam is > 0 ? RangeParam.Value : TimeSeriesChartView.DefaultRangeDays,
        BucketsParam ?? TimeSeriesGranularity.Auto,
        ChartModeParam ?? TimeSeriesChartMode.Bar);

    private ReleaseDetailResponse? release;
    private CommitInfo? commitInfo;
    private bool loading = true;
    private string? loadError;
    private TimeSeries? _releaseHistogram;
    private int _loadedReleaseId;
    private TimeSeriesChartView? _loadedView;

    protected override async Task OnParametersSetAsync()
    {
        if (release is not null && _loadedReleaseId == ReleaseId)
        {
            if (_loadedView != ChartView)
            {
                _loadedView = ChartView;
                _releaseHistogram = null;
                if (release.TopIssues.Count > 0)
                    await LoadHistogramAsync(release.TopIssues.Select(i => i.IssueId).ToList());
            }

            return;
        }

        _loadedReleaseId = ReleaseId;
        _loadedView = ChartView;

        await LoadReleaseAsync();
    }

    private async Task LoadReleaseAsync()
    {
        loading = true;
        loadError = null;
        _releaseHistogram = null;
        commitInfo = null;

        try { release = await ReleaseHealthService.GetReleaseDetailAsync(ReleaseId); }
        catch (Exception ex) when (ex is HttpRequestException or ArgumentException)
        {
            release = null;
            loadError = ex is ArgumentException ? ex.Message : "Could not load this release. The request failed.";
            loading = false;
            return;
        }

        loading = false;

        if (release?.CommitSha != null)
           await LoadCommitInfoAsync(release.CommitSha);

        if (release?.TopIssues.Count > 0)
            await LoadHistogramAsync(release.TopIssues.Select(i => i.IssueId).ToList());
    }

    private async Task LoadCommitInfoAsync(string commitSha)
    {
        try
        {
            commitInfo = await SourceCodeSvc.GetCommitInfoAsync(ProjectId, commitSha);
            StateHasChanged();
        }
        catch (Exception ex) when (ex is HttpRequestException or ArgumentException)
        {
            // commit info is best-effort; the release itself is already loaded
        }
    }

    private async Task LoadHistogramAsync(List<int> issueIds)
    {
        try
        {
            var bulk = await IssueService.GetBulkHistogramsAsync(issueIds, ChartView.RangeDays, ChartView.Granularity);
            if (bulk.Count == 0) return;

            var series = bulk.Values.ToList();
            var combined = series
                .SelectMany(s => s.Points)
                .GroupBy(p => p.Start)
                .OrderBy(g => g.Key)
                .Select(g => new TimeSeriesPoint(g.Key, g.Sum(p => p.Count)))
                .ToList();

            _releaseHistogram = new TimeSeries(
                series.Min(s => s.From),
                series.Max(s => s.To),
                series[0].Interval,
                combined);
            StateHasChanged();
        }
        catch (Exception ex) when (ex is HttpRequestException or ArgumentException)
        {
            // the chart is best-effort; the release itself is already loaded
        }
    }

    private void OnChartViewChanged(TimeSeriesChartView view) =>
        Navigation.NavigateTo(ChartQueryState.Apply(new Uri(Navigation.Uri), view).PathAndQuery, replace: true);
}
